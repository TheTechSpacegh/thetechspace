# Copy to .env.local for local development. On Railway, VITE_API_URL comes
# from the shared API_URL variable (.railway/railway.ts); it's built in, so
# redeploy after changing it.

# The TTS API (the backend repo). Without it, public pages show the built-in
# content and the admin console asks for the backend to be connected.
VITE_API_URL=http://localhost:4000
